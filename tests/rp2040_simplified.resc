using sysbus
mach create "rp2040"

# Load our local platform description instead of looking in Renode's platform directory
machine LoadPlatformDescription @${CURDIR}/platforms/rp2040_basic.repl

# Configure CPU
cpu0 IsHalted false

# Load the bootloader binary if provided
$bin?=@${CURDIR}/../build/picocalc_sd_boot.elf
sysbus LoadELF $bin

# Configure UART for bootloader output
uart0 CreateFileBackend @uart0.log
uart0 WriteChar `\n`

# Add simple tags for peripheral regions we're not fully implementing
sysbus:
    init:
        Tag <0x40058000 0x1000> "WATCHDOG"
        Tag <0x400D0000 0x4> "SYSCFG"
        Tag <0x50110000 0x1000> "USB"
        Tag <0x50000000 0x1000> "DMA"

# Log access to important regions
python """
def log_access(cpu, pc, addr, size, isWrite):
    if addr >= 0x40058000 and addr < 0x40059000:
        print(f"Watchdog access at PC=0x{pc:08x}: {'Write' if isWrite else 'Read'} addr=0x{addr:08x}")
    elif addr >= 0x50110000 and addr < 0x50111000:
        print(f"USB access at PC=0x{pc:08x}: {'Write' if isWrite else 'Read'} addr=0x{addr:08x}")

sysbus.cpu0.SetHookAtMemoryAccess(log_access, 0x40058000, 0x1000)
sysbus.cpu0.SetHookAtMemoryAccess(log_access, 0x50110000, 0x1000)
"""

# Set initial PC to bootloader entry point
cpu0 PC 0x10000000

echo "Simplified RP2040 test ready. Use 'start' to begin simulation." 