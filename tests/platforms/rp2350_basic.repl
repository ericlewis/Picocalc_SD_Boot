// Simplified Raspberry Pi Pico 2 (RP2350) Platform Description for Renode
// Uses generic peripherals that are available in standard Renode

flash: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x1000000  // 16MB flash

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x80000    // 512KB SRAM (RP2350 has more RAM)

cpu0: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"  // RP2350 uses Cortex-M33
    nvic: nvic0

nvic0: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu0@0

// Use generic UART instead of RP2350-specific
uart0: UART.PL011 @ sysbus 0x40034000
    -> nvic0@20

// Timer using generic Cortex-M SysTick
systick: CPU.ARMv7M_SysTick @ sysbus 0xE000E010
    parentCPU: cpu0
    -> nvic0@15

// Generic SPI controllers
spi0: SPI.STM32SPI @ sysbus 0x4003c000
    -> nvic0@18

spi1: SPI.STM32SPI @ sysbus 0x40040000
    -> nvic0@19

// Generic GPIO
gpio0: GPIOPort.STM32_GPIOPort @ sysbus 0x40014000
    numberOfAFs: 1

// Tag memory regions
sysbus:
    init:
        Tag <0x40000000 0x1000> "APB_BRIDGE"
        Tag <0x40004000 0x1000> "SYSINFO"
        Tag <0x40008000 0x1000> "CLOCKS" 
        Tag <0x4000c000 0x1000> "RESETS"
        Tag <0x40058000 0x1000> "WATCHDOG"
        Tag <0x50000000 0x10000000> "AHB_LITE" 