// Raspberry Pi Pico 2 (RP2350) Platform Description for Renode
// NOTE: This is a simplified model based on the RP2040.
// Renode does not have full, dedicated RP2350 support yet.

using "peripherals/resets.repl"

flash: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x1000000  // 16MB flash

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x80000    // 512KB SRAM

cpu0: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"
    nvic: nvic0

nvic0: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu0@0

// Using RP2040 peripherals as placeholders for now
uart0: UART.RP2040_UART @ sysbus 0x40034000
    -> nvic0@20

spi0: SPI.RP2040_SPI @ sysbus 0x4003c000
    -> nvic0@18

spi1: SPI.RP2040_SPI @ sysbus 0x40040000
    -> nvic0@19

gpio0: GPIOPort.RP2040_GPIO @ sysbus 0x40014000
    numberOfPins: 30

dma: DMA.RP2040_DMA @ sysbus 0x50000000
    -> nvic0@11

syscfg: Miscellaneous.RP2040_SYSCFG @ sysbus 0x40004000

clocks: Miscellaneous.RP2040_Clocks @ sysbus 0x40008000
    pllSys: pll_sys
    pllUsb: pll_usb
    rosc: rosc
    xosc: xosc
    
pll_sys: Miscellaneous.RP2040_PLL @ sysbus 0x40028000

pll_usb: Miscellaneous.RP2040_PLL @ sysbus 0x4002c000

xosc: Miscellaneous.RP2040_XOSC @ sysbus 0x40024000

rosc: Miscellaneous.RP2040_ROSC @ sysbus 0x40060000

resets: Memory.MappedMemory @ sysbus 0x4000c000
    size: 0x1000

pads_bank0: GPIOPort.RP2040_Pads @ sysbus 0x4001c000
pads_qspi: GPIOPort.RP2040_Pads @ sysbus 0x40020000
busctrl: Miscellaneous.RP2040_BUSCTRL @ sysbus 0x40030000
jtag: Miscellaneous.RP2040_JTAG @ sysbus 0x40064000 